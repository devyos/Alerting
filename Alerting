#!/usr/bin/env python3
"""
proxmox_alerts_api.py - FastAPI service that collects Proxmox VE alerts on demand.

No internal scheduler: an external cronjob calls  POST /check  and the service
queries the Proxmox API, compares the result with the previous run and returns
the new / resolved / active alerts. State is kept in a JSON file so it
survives restarts.

Endpoints:
  POST /check           run all checks now (called by cron)
  GET  /alerts          active alerts (filters ?severity=&source=)
  GET  /alerts/history  last emitted alerts (firing + resolved)
  POST /proxmox         receiver for native Proxmox notifications (PVE >= 8.3 webhook)
  GET  /health          service status
  Docs: /docs

Install : pip install fastapi "uvicorn[standard]" httpx
Run     : uvicorn proxmox_alerts_api:app --host 0.0.0.0 --port 8080
"""

import asyncio
import json
import logging
import os
import time
import uuid
from contextlib import asynccontextmanager
from pathlib import Path
from typing import Any, Literal, Optional

import httpx
from fastapi import Depends, FastAPI, Header, HTTPException, Query
from pydantic import BaseModel, Field

# --------------------------------------------------------------------------
# Configuration (environment variables)
# --------------------------------------------------------------------------
PVE_HOST = os.getenv("PVE_HOST", "https://pve.example.local:8006")
PVE_TOKEN_ID = os.getenv("PVE_TOKEN_ID", "monitoring@pve!alerts")   # user@realm!tokenid
PVE_TOKEN_SECRET = os.getenv("PVE_TOKEN_SECRET", "")
PVE_VERIFY_SSL = os.getenv("PVE_VERIFY_SSL", "false").lower() == "true"

CPU_THRESHOLD = float(os.getenv("CPU_THRESHOLD", "0.90"))
MEM_THRESHOLD = float(os.getenv("MEM_THRESHOLD", "0.90"))
DISK_THRESHOLD = float(os.getenv("DISK_THRESHOLD", "0.85"))
SSD_WEAROUT_MIN = int(os.getenv("SSD_WEAROUT_MIN", "10"))           # % life left
CHECK_UPDATES = os.getenv("CHECK_UPDATES", "true").lower() == "true"
CHECK_SUBSCRIPTION = os.getenv("CHECK_SUBSCRIPTION", "true").lower() == "true"
REPL_MAX_LAG = int(os.getenv("REPL_MAX_LAG", "3600"))              # seconds since last sync
CERT_WARN_DAYS = int(os.getenv("CERT_WARN_DAYS", "30"))
SUB_WARN_DAYS = int(os.getenv("SUB_WARN_DAYS", "30"))
IGNORE_TAG = os.getenv("IGNORE_TAG", "nomonitor")                  # VM tag to skip "stopped" check

API_KEY = os.getenv("API_KEY", "")              # protects /check & /alerts (header X-API-Key)
WEBHOOK_SECRET = os.getenv("WEBHOOK_SECRET", "")  # protects /proxmox (header X-Webhook-Secret)
FORWARD_URL = os.getenv("FORWARD_URL", "")      # optional: push new/resolved alerts (Slack, Teams, n8n...)
STATE_FILE = Path(os.getenv("STATE_FILE", "./alerts_state.json"))
HISTORY_SIZE = int(os.getenv("HISTORY_SIZE", "1000"))

logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
log = logging.getLogger("pve-alerts")

Severity = Literal["info", "warning", "critical"]


# --------------------------------------------------------------------------
# Models
# --------------------------------------------------------------------------
class Alert(BaseModel):
    key: str
    severity: Severity
    source: str
    title: str
    message: str
    status: Literal["firing", "resolved"] = "firing"
    timestamp: float = Field(default_factory=time.time)
    details: dict[str, Any] = Field(default_factory=dict)


class CheckResult(BaseModel):
    checked_at: float
    duration_s: float
    new: list[Alert]
    resolved: list[Alert]
    active: list[Alert]
    errors: list[str]


class ProxmoxNotification(BaseModel):
    title: str = "Proxmox notification"
    message: str = ""
    severity: str = "info"              # info | notice | warning | error
    timestamp: Optional[int] = None
    fields: dict[str, Any] = Field(default_factory=dict)


# --------------------------------------------------------------------------
# Persistent state (JSON file)
# --------------------------------------------------------------------------
class State:
    def __init__(self, path: Path):
        self.path = path
        self.active: dict[str, Alert] = {}
        self.history: list[Alert] = []
        self.last_check: Optional[float] = None
        self.last_errors: list[str] = []
        self.load()

    def load(self):
        if not self.path.exists():
            return
        try:
            raw = json.loads(self.path.read_text())
            self.active = {k: Alert(**v) for k, v in raw.get("active", {}).items()}
            self.history = [Alert(**a) for a in raw.get("history", [])]
            self.last_check = raw.get("last_check")
        except Exception as e:
            log.error("Could not read state file %s: %s", self.path, e)

    def save(self):
        self.history = self.history[-HISTORY_SIZE:]
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps({
            "last_check": self.last_check,
            "active": {k: a.model_dump() for k, a in self.active.items()},
            "history": [a.model_dump() for a in self.history],
        }))
        tmp.replace(self.path)


# --------------------------------------------------------------------------
# Proxmox API client
# --------------------------------------------------------------------------
class ProxmoxAPI:
    def __init__(self):
        self.client = httpx.AsyncClient(
            base_url=PVE_HOST.rstrip("/") + "/api2/json",
            headers={"Authorization": f"PVEAPIToken={PVE_TOKEN_ID}={PVE_TOKEN_SECRET}"},
            verify=PVE_VERIFY_SSL,
            timeout=15,
        )

    async def get(self, path: str, **params):
        r = await self.client.get(path, params=params)
        r.raise_for_status()
        return r.json().get("data")

    async def try_get(self, path: str, **params):
        """Returns None when the endpoint is missing or not allowed."""
        try:
            return await self.get(path, **params)
        except httpx.HTTPStatusError as e:
            log.debug("GET %s -> %s", path, e.response.status_code)
            return None

    async def close(self):
        await self.client.aclose()


# --------------------------------------------------------------------------
# Checks
# --------------------------------------------------------------------------
def A(key: str, severity: Severity, source: str, title: str, message: str, **details) -> Alert:
    return Alert(key=key, severity=severity, source=source, title=title, message=message, details=details)


async def check_cluster(api: ProxmoxAPI) -> list[Alert]:
    out = []
    for i in await api.try_get("/cluster/status") or []:
        if i["type"] == "cluster" and not i.get("quorate", 1):
            out.append(A("quorum", "critical", "cluster", "Cluster lost quorum", f"Cluster {i.get('name')}"))
        if i["type"] == "node" and not i.get("online"):
            out.append(A(f"node-offline:{i['name']}", "critical", "node", "Node offline", f"{i['name']} is offline"))
    return out


async def check_resources(api: ProxmoxAPI) -> list[Alert]:
    out = []
    for r in await api.try_get("/cluster/resources") or []:
        t = r.get("type")
        if t == "node" and r.get("status") == "online":
            n = r["node"]
            if r.get("cpu", 0) > CPU_THRESHOLD:
                out.append(A(f"cpu:{n}", "warning", "node", "High CPU", f"{n}: CPU {r['cpu']:.0%}"))
            if r.get("maxmem") and r["mem"] / r["maxmem"] > MEM_THRESHOLD:
                out.append(A(f"mem:{n}", "warning", "node", "High memory", f"{n}: RAM {r['mem'] / r['maxmem']:.0%}"))
        elif t == "storage":
            sid = f"{r['node']}/{r['storage']}"
            if r.get("status") != "available":
                out.append(A(f"storage-down:{sid}", "critical", "storage", "Storage unavailable",
                             f"{sid}: {r.get('status')}"))
            elif r.get("maxdisk") and r["disk"] / r["maxdisk"] > DISK_THRESHOLD:
                out.append(A(f"storage-full:{sid}", "warning", "storage", "Storage almost full",
                             f"{sid}: {r['disk'] / r['maxdisk']:.0%} used"))
        elif t in ("qemu", "lxc") and r.get("lock"):
            out.append(A(f"locked:{r['id']}", "info", "guest", "VM/CT locked",
                         f"{r['id']} ({r.get('name')}) lock={r['lock']}"))
    return out


async def check_ha(api: ProxmoxAPI) -> list[Alert]:
    out = []
    for h in await api.try_get("/cluster/ha/status/current") or []:
        st = str(h.get("status", "")).lower()
        if any(w in st for w in ("error", "fence", "dead", "unknown")) or h.get("state") == "error":
            out.append(A(f"ha:{h.get('id')}", "critical", "ha", "HA problem", f"{h.get('id')}: {h.get('status')}"))
    return out


async def check_stopped_guests(api: ProxmoxAPI) -> list[Alert]:
    """VM/CT stopped although it should run: onboot=1 in its config, or HA state 'started'."""
    resources = await api.try_get("/cluster/resources", type="vm") or []
    ha = {h.get("sid"): h.get("state") for h in await api.try_get("/cluster/ha/resources") or []}
    stopped = [r for r in resources
               if r.get("status") == "stopped" and not r.get("template")
               and IGNORE_TAG not in str(r.get("tags", "")).split(";")]

    async def should_run(r) -> Optional[str]:
        if ha.get(r["id"].replace("qemu/", "vm:").replace("lxc/", "ct:")) == "started":
            return "HA state is 'started'"
        cfg = await api.try_get(f"/nodes/{r['node']}/{r['type']}/{r['vmid']}/config") or {}
        return "onboot=1" if str(cfg.get("onboot", "0")) == "1" else None

    reasons = await asyncio.gather(*(should_run(r) for r in stopped))
    return [A(f"guest-stopped:{r['id']}", "critical", "guest", "VM/CT stopped but should be running",
              f"{r['id']} ({r.get('name')}) on {r['node']} is stopped ({why})")
            for r, why in zip(stopped, reasons) if why]


async def check_backups(api: ProxmoxAPI) -> list[Alert]:
    return [A(f"nobackup:{g.get('vmid')}", "warning", "backup", "VM/CT not in any backup job",
              f"{g.get('vmid')} ({g.get('name')})")
            for g in await api.try_get("/cluster/backup-info/not-backed-up") or []]


async def check_node(api: ProxmoxAPI, node: str) -> list[Alert]:
    out = []
    now = time.time()
    disks, reps, upd, certs, zpools, sub = await asyncio.gather(
        api.try_get(f"/nodes/{node}/disks/list"),
        api.try_get(f"/nodes/{node}/replication"),
        api.try_get(f"/nodes/{node}/apt/update") if CHECK_UPDATES else asyncio.sleep(0),
        api.try_get(f"/nodes/{node}/certificates/info"),
        api.try_get(f"/nodes/{node}/disks/zfs"),
        api.try_get(f"/nodes/{node}/subscription") if CHECK_SUBSCRIPTION else asyncio.sleep(0),
    )

    # Replication lag (job not failing but not syncing either)
    for rep in reps or []:
        last = rep.get("last_sync") or 0
        if last and now - last > REPL_MAX_LAG:
            out.append(A(f"repl-lag:{rep.get('id')}", "warning", "replication", "Replication lagging",
                         f"{rep.get('id')}: last sync {int((now - last) / 60)} min ago"))

    # Certificates
    for c in certs or []:
        not_after = c.get("notafter")
        if not not_after:
            continue
        days = (not_after - now) / 86400
        if days <= CERT_WARN_DAYS:
            sev = "critical" if days <= 0 else "warning"
            msg = "expired" if days <= 0 else f"expires in {int(days)} day(s)"
            out.append(A(f"cert:{node}:{c.get('filename')}", sev, "certificate", "Certificate expiring",
                         f"{node} {c.get('filename')} ({c.get('subject')}): {msg}"))

    # ZFS pools
    for p in zpools or []:
        health = str(p.get("health", "")).upper()
        if health and health != "ONLINE":
            sev = "warning" if health == "DEGRADED" else "critical"
            out.append(A(f"zfs:{node}:{p.get('name')}", sev, "zfs", f"ZFS pool {health}",
                         f"{node} pool {p.get('name')} is {health}"))
        if p.get("size") and p.get("alloc") and p["alloc"] / p["size"] > DISK_THRESHOLD:
            out.append(A(f"zfs-full:{node}:{p.get('name')}", "warning", "zfs", "ZFS pool almost full",
                         f"{node} pool {p.get('name')}: {p['alloc'] / p['size']:.0%} used"))

    # Subscription
    if sub:
        status = str(sub.get("status", "")).lower()
        if status != "active":
            sev = "info" if status in ("notfound", "new") else "warning"
            out.append(A(f"subscription:{node}", sev, "subscription", "No active subscription",
                         f"{node}: subscription status '{status}'"))
        elif sub.get("nextduedate"):
            try:
                due = time.mktime(time.strptime(sub["nextduedate"], "%Y-%m-%d"))
                if (due - now) / 86400 <= SUB_WARN_DAYS:
                    out.append(A(f"subscription-due:{node}", "warning", "subscription",
                                 "Subscription renewal due", f"{node}: due on {sub['nextduedate']}"))
            except ValueError:
                pass

    for d in disks or []:
        health = str(d.get("health", "")).upper()
        if health and health not in ("PASSED", "OK", "UNKNOWN"):
            out.append(A(f"smart:{node}:{d['devpath']}", "critical", "smart", "Disk SMART failure",
                         f"{node} {d['devpath']} ({d.get('model')}): {health}"))
        wear = d.get("wearout")
        if isinstance(wear, (int, float)) and wear <= SSD_WEAROUT_MIN:
            out.append(A(f"wear:{node}:{d['devpath']}", "warning", "smart", "SSD worn out",
                         f"{node} {d['devpath']}: {wear}% life left"))
    for rep in reps or []:
        if rep.get("fail_count", 0) > 0 or rep.get("error"):
            out.append(A(f"repl:{rep.get('id')}", "critical", "replication", "Replication failing",
                         f"{rep.get('id')}: {rep.get('error')}"))
    if upd:
        out.append(A(f"updates:{node}", "info", "updates", "Updates available",
                     f"{node}: {len(upd)} package(s) to upgrade"))
    return out


async def failed_tasks_since(api: ProxmoxAPI, since: Optional[float]) -> list[Alert]:
    """Failed tasks that finished since the previous check (one-shot events)."""
    if since is None:           # first run: don't alert on old history
        return []
    out = []
    for t in await api.try_get("/cluster/tasks") or []:
        status, end = t.get("status"), t.get("endtime") or 0
        if status in (None, "OK") or end <= since:
            continue
        sev = "warning" if status.startswith("WARNINGS") else "critical"
        out.append(A(f"task:{t.get('upid')}", sev, "task", f"Task failed: {t.get('type')}",
                     f"{t.get('node')} {t.get('type')} {t.get('id', '')} by {t.get('user')} -> {status}",
                     **t))
    return out


# --------------------------------------------------------------------------
# Check orchestration
# --------------------------------------------------------------------------
async def forward(http: httpx.AsyncClient, alerts: list[Alert]):
    if not FORWARD_URL:
        return
    for a in alerts:
        try:
            await http.post(FORWARD_URL, json=a.model_dump(), timeout=10)
        except httpx.HTTPError as e:
            log.error("Forward failed: %s", e)


async def run_check(api: ProxmoxAPI, state: State, http: httpx.AsyncClient) -> CheckResult:
    started = time.time()
    errors: list[str] = []
    current: list[Alert] = []
    one_shots: list[Alert] = []

    try:
        nodes = [n["node"] for n in await api.get("/nodes") if n.get("status") == "online"]
        checks = [check_cluster(api), check_resources(api), check_ha(api),
                  check_stopped_guests(api), check_backups(api), *(check_node(api, n) for n in nodes)]
        for res in await asyncio.gather(*checks, return_exceptions=True):
            if isinstance(res, Exception):
                errors.append(repr(res))
            else:
                current.extend(res)
        one_shots = await failed_tasks_since(api, state.last_check)
    except httpx.HTTPError as e:
        errors.append(str(e))
        current = [A("api-unreachable", "critical", "api", "Proxmox API unreachable", str(e))]
        # keep other alerts as-is: we can't know if they're resolved
        current += [a for k, a in state.active.items() if k != "api-unreachable"]

    current_keys = {a.key for a in current}
    new = [a for a in current if a.key not in state.active]
    resolved = [state.active[k].model_copy(update={"status": "resolved", "timestamp": started})
                for k in state.active if k not in current_keys]

    for a in new:
        state.active[a.key] = a
    for a in resolved:
        state.active.pop(a.key, None)

    emitted = new + one_shots + resolved
    state.history.extend(emitted)
    state.last_check = started
    state.last_errors = errors
    state.save()

    for a in emitted:
        log.info("ALERT %s", a.model_dump_json())
    await forward(http, emitted)

    return CheckResult(checked_at=started, duration_s=round(time.time() - started, 2),
                       new=new + one_shots, resolved=resolved,
                       active=sorted(state.active.values(), key=lambda a: a.timestamp, reverse=True),
                       errors=errors)


# --------------------------------------------------------------------------
# FastAPI app
# --------------------------------------------------------------------------
@asynccontextmanager
async def lifespan(app: FastAPI):
    if not PVE_TOKEN_SECRET:
        raise RuntimeError("PVE_TOKEN_SECRET is not set")
    app.state.api = ProxmoxAPI()
    app.state.http = httpx.AsyncClient()
    app.state.store = State(STATE_FILE)
    app.state.lock = asyncio.Lock()
    yield
    await app.state.api.close()
    await app.state.http.aclose()


app = FastAPI(title="Proxmox Alerts", version="2.0", lifespan=lifespan)


def require_api_key(x_api_key: Optional[str] = Header(None)):
    if API_KEY and x_api_key != API_KEY:
        raise HTTPException(status_code=401, detail="Invalid API key")


@app.post("/check", response_model=CheckResult, dependencies=[Depends(require_api_key)])
async def check():
    """Run every check now. Call this from cron."""
    if app.state.lock.locked():
        raise HTTPException(status_code=409, detail="A check is already running")
    async with app.state.lock:
        return await run_check(app.state.api, app.state.store, app.state.http)


@app.get("/alerts", response_model=list[Alert], dependencies=[Depends(require_api_key)])
async def list_alerts(severity: Optional[Severity] = None, source: Optional[str] = None):
    alerts = list(app.state.store.active.values())
    if severity:
        alerts = [a for a in alerts if a.severity == severity]
    if source:
        alerts = [a for a in alerts if a.source == source]
    return sorted(alerts, key=lambda a: a.timestamp, reverse=True)


@app.get("/alerts/history", response_model=list[Alert], dependencies=[Depends(require_api_key)])
async def alerts_history(limit: int = Query(100, ge=1, le=HISTORY_SIZE)):
    return app.state.store.history[-limit:][::-1]


@app.post("/proxmox", status_code=202)
async def proxmox_webhook(notif: ProxmoxNotification, x_webhook_secret: Optional[str] = Header(None)):
    """Receiver for Proxmox's own notifications (backup jobs, fencing, replication, updates...)."""
    if WEBHOOK_SECRET and x_webhook_secret != WEBHOOK_SECRET:
        raise HTTPException(status_code=401, detail="Invalid secret")
    sev = {"error": "critical", "warning": "warning"}.get(notif.severity, "info")
    alert = A(f"webhook:{uuid.uuid4()}", sev, "pve-notification", notif.title, notif.message, **notif.fields)
    if notif.timestamp:
        alert.timestamp = notif.timestamp
    store: State = app.state.store
    store.history.append(alert)
    store.save()
    log.info("ALERT %s", alert.model_dump_json())
    await forward(app.state.http, [alert])
    return {"status": "accepted"}


@app.get("/health")
async def health():
    s: State = app.state.store
    return {"status": "degraded" if s.last_errors else "ok",
            "last_check": s.last_check, "errors": s.last_errors,
            "active_alerts": len(s.active)}


if __name__ == "__main__":
    import uvicorn
    uvicorn.run(app, host="0.0.0.0", port=int(os.getenv("PORT", "8080")))
